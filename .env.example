# Copy this file to .env and fill in real values.
# Never commit .env.

# ─── Postgres (Neon) ──────────────────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection Details
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
POSTGRES_URL=postgresql://user:pass@host.neon.tech/news_kg?sslmode=require

# ─── Neo4j (AuraDB Free) ──────────────────────────────────────────────────────
# Get from https://console.neo4j.io → your instance → Connect
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me

# ─── LLM (Gemini, free tier) ──────────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash

# ─── Optional ─────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking (free tier). Leave empty to disable.
SENTRY_DSN=

# Log level for the pipeline (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ─── Web app only ─────────────────────────────────────────────────────────────
# Same Postgres URL but with pgbouncer/pooled connection (Neon provides both).
# Use the *pooled* one here for serverless functions.
DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/news_kg?sslmode=require

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
